default_platform(:ios)

APP_IDENTIFIER = "com.basematch.app".freeze
TEAM_ID = "TFGTJ2C22L".freeze

# API キーは複数の lane で使うため一箇所で組み立てる。
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    duration: 1200,
  )
end

platform :ios do
  desc "TestFlight の最新ビルド番号 + 1 を返す"
  desc "ビルド番号は CI の実行回数から採らない。re-run で値が変わらず、"
  desc "同じ番号で再アップロードして必ず弾かれるため。"
  lane :next_build_number do
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      # TestFlight に1件も無い（初回配信前）と例外になるため 0 を起点にする
      initial_build_number: 0,
    )
    next_number = latest + 1
    UI.message("次のビルド番号: #{next_number}")
    # 標準出力は fastlane 自身のログ（完了メッセージ等）が混ざるため、
    # 呼び出し側はファイル経由で受け取る。
    out = ENV["BUILD_NUMBER_OUTPUT"]
    File.write(out, next_number) if out
    next_number
  end

  desc "証明書とプロファイルを新規作成して certificates リポジトリへ保存する"
  desc "ローカルの Mac で最初に一度だけ実行する。CI は readonly のため作成できない。"
  lane :setup_certificates do
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: asc_api_key,
      readonly: false,
    )
  end

  desc "TestFlight へ配信する"
  lane :beta do
    # 一時キーチェーンを作る。これが無いと match が
    # ロック解除ダイアログを待って無限にハングする（エラーにならない）。
    setup_ci if is_ci

    api_key = asc_api_key

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: is_ci,
    )

    build_number = ENV["BUILD_NUMBER"]
    UI.user_error!("BUILD_NUMBER が指定されていません") if build_number.to_s.empty?

    # 自動署名のままだと CI で証明書を選べないため、match が取得した
    # プロファイルを明示的に割り当てる。
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      .fetch(APP_IDENTIFIER)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "BaseMatch.xcodeproj",
      targets: ["BaseMatch"],
      build_configurations: ["Release"],
      team_id: TEAM_ID,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    increment_build_number(
      xcodeproj: "BaseMatch.xcodeproj",
      build_number: build_number,
    )

    build_app(
      project: "BaseMatch.xcodeproj",
      scheme: "BaseMatch",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      export_team_id: TEAM_ID,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # 暗号化に関する輸出コンプライアンス。外部通信をしないアプリなので false。
      uses_non_exempt_encryption: false,
      # 処理完了を待つと macOS ランナーの課金が伸びる。
      # 失敗した場合は App Store Connect からメールで通知される。
      skip_waiting_for_build_processing: true,
    )
  end
end
